# ============================================================
# chat-dune — Environment Variables
# Copy this file to .env.local (for Next.js) and fill in values.
# Never commit .env.local or any file with real secrets.
# ============================================================

# ---- Supabase -----------------------------------------------
# Public URL for the Supabase project (exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000

# Public anon key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-side only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# ---- Google AI / Gemini -------------------------------------
# API key for Google AI Studio (development, API key auth)
# Get from https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Gemini model to use (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# ---- Anthropic / Claude (unused — Gemini is the AI layer) ---
# ANTHROPIC_API_KEY=

# ---- Dune Analytics -----------------------------------------
# API key for Dune MCP / REST API
DUNE_API_KEY=

# ---- Blockchain RPC ------------------------------------------
# Starknet JSON-RPC endpoint (Infura, Blast, self-hosted, etc.)
STARKNET_RPC_URL=

# Ethereum JSON-RPC endpoint (optional — used in Phase 4+)
# ETHEREUM_RPC_URL=

# ---- App Config ----------------------------------------------
# Base URL for the deployed app (used for share links, auth redirects)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Whether new user signup is enabled ("true" | "false")
# When false, users must be created manually via Supabase Dashboard.
# SIGNUP_ENABLED=true
